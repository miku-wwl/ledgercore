      "lab": [
        {
          "file": "evidence/round4/e12/lab/E12-LAB.json",
          "path": "transfer-precommit-crash.recovery",
          "expect": "PASS"
        },
        {
          "file": "evidence/round4/e12/lab/E12-LAB.json",
          "path": "transfer-postcommit-response-crash.recovery",
          "expect": "PASS"
        }
      ]
